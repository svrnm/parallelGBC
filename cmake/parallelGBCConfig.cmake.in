@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(OpenMP COMPONENTS CXX)
find_dependency(Boost COMPONENTS regex)
@PARALLELOGBC_MPI_CONFIG_BLOCK@

find_library(parallelGBC_TBB_LIBRARY NAMES tbb REQUIRED)
find_path(parallelGBC_TBB_INCLUDE_DIR NAMES tbb/tbb.h REQUIRED)

if(NOT TARGET parallelGBC::TBB)
	add_library(parallelGBC::TBB INTERFACE IMPORTED)
	set_target_properties(parallelGBC::TBB PROPERTIES
		INTERFACE_LINK_LIBRARIES "${parallelGBC_TBB_LIBRARY}"
		INTERFACE_INCLUDE_DIRECTORIES "${parallelGBC_TBB_INCLUDE_DIR}")
endif()

include("${CMAKE_CURRENT_LIST_DIR}/parallelGBCTargets.cmake")
